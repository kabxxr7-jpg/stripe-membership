# Stripe TEST key only (sk_test_...). The app refuses live keys.
STRIPE_SECRET_KEY=sk_test_replace_me
# Public address Stripe and visitors reach (Checkout success/cancel URLs and webhook endpoints use it)
PUBLIC_BASE_URL=https://members.example.com
# Written by `npm run setup:stripe`:
SESSION_SECRET=
STRIPE_WEBHOOK_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
# Optional
PORT=8082
DB_PATH=data/members.db
